# ==============================================
# Smart Resume Docker Compose 配置文件
# ==============================================
# 复制此文件为 .env 并根据实际情况修改配置

# ----------------------------------------------
# 数据库配置 (PostgreSQL 17.6)
# ----------------------------------------------
# 数据库名称（容器首次启动时自动创建）
DB_NAME=smart_resume
DB_USER=postgres
# 数据库密码（生产环境请务必修改）
DB_PASSWORD=postgres
# 数据库暴露到宿主机的端口（默认 5432）
DB_PORT=5432

# ----------------------------------------------
# 后端配置 (Spring Boot 3 + JDK 21)
# ----------------------------------------------
# Spring 运行环境 (dev/test/prod)
SPRING_PROFILE=prod

# 后端服务暴露到宿主机的端口（默认 8080）
BACKEND_PORT=8080

# JWT Token 密钥（生产环境请务必修改为复杂字符串）
TOKEN_SECRET=change-me-in-production-use-a-long-random-string

# JVM 参数配置
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC

# ----------------------------------------------
# 前端配置 (React + Node 20)
# ----------------------------------------------
# API 基础路径（通过 Nginx 代理，默认 /api）
VITE_API_BASE_URL=/api

# ----------------------------------------------
# Nginx 配置
# ----------------------------------------------
# HTTP 端口（默认 80）
NGINX_HTTP_PORT=80

# HTTPS 端口（默认 443，需要配置 SSL 证书）
NGINX_HTTPS_PORT=443

# ----------------------------------------------
# 其他配置
# ----------------------------------------------
# 应用访问域名（用于 Nginx 配置）
APP_DOMAIN=localhost

# 是否启用 HTTPS（true/false）
ENABLE_HTTPS=false
